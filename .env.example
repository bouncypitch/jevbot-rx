# Your own TypeSafe AI key. Used server-side by npm run dev / preview.
# Local mode skips login and demo credits; no OAuth secrets are needed.
TYPESAFE_API_KEY=your_key_here
# USD per million tokens; TypeSafe launch pricing, September 14 2026.
JEV_INPUT_PRICE=0.042
JEV_OUTPUT_PRICE=0

# Optional server binding overrides (defaults to localhost).
# JEV_HOST=localhost
# JEV_ALLOWED_HOSTS=your-hostname.example

# Brain Race: off-the-shelf LLM on GMI Cloud (OpenAI-compatible)
GMI_API_KEY=your_gmi_key
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=deepseek-ai/DeepSeek-V4-Flash
GMI_INPUT_PRICE=0.14
GMI_OUTPUT_PRICE=0.28
